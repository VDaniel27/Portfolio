</section>

<!-- EDUCACIÓN / EDUCATION -->
<section id="educacion" class="section">
    <div class="container">
        <h3 class="section-title">@(Lang.IsEnglish ? "Education" : "Educación")</h3>
        <div class="edu-card animate-on-scroll">
            <div class="edu-icon"><i class="fas fa-graduation-cap"></i></div>
