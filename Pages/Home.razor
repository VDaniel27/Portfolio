@code {
    [Inject] IJSRuntime JS { get; set; } = default!;

    private int activeRole = 0;
    private int previousRole = 0;

    private void SetRole(int role)
    {
        previousRole = activeRole;
        activeRole = role;
    }

    protected override void OnInitialized()
    {
        Lang.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initPortfolio");
        }
        else if (activeRole != previousRole)
        {
            previousRole = activeRole;
            await JS.InvokeVoidAsync("observeAnimations");
        }
    }

    public void Dispose()
    {
        Lang.OnChange -= StateHasChanged;
    }
}
