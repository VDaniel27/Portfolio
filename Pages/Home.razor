                    <div class="timeline-header">
                        <div>
                            <h4>@(activeRole == 0 ? (Lang.IsEnglish ? "Full-stack Developer (Freelance)" : "Desarrollador Full-stack (Freelance)") : (Lang.IsEnglish ? "Systems Engineer (Freelance)" : "Ingeniero de Sistemas (Freelance)"))</h4>
                            <p class="company"><i class="fas fa-building"></i> Médicos Sin Fronteras (MSF)</p>
                        </div>
                        <span class="badge-date">@(Lang.IsEnglish ? "Aug 2025 – Apr 2026" : "Ago 2025 – Abr 2026")</span>
                    </div>
                    @if (activeRole == 0)
                    {
                        @if (Lang.IsEnglish)
                        {
                            <ul>
                                <li>Led the full-cycle development of a web platform for donation management and corporate partnerships.</li>
                                <li>Designed and implemented a RESTful API with over 150 endpoints, ensuring high security, scalability, and robust data authentication.</li>
                                <li>Developed dynamic, responsive user interfaces focused on User Experience (UX).</li>
                                <li>Automated administrative workflows, significantly reducing manual workload for the finance team.</li>
                            </ul>
                        }
                        else
                        {
                            <ul>
                                <li>Lideré el desarrollo integral de una plataforma web para la gestión de donativos y vinculación empresarial.</li>
                                <li>Diseñé e implementé una API RESTful con más de 150 endpoints, garantizando la seguridad, escalabilidad y la correcta autenticación de datos críticos.</li>
                                <li>Desarrollé interfaces dinámicas y responsivas enfocadas en la experiencia de usuario (UX).</li>
                                <li>Automaticé flujos de trabajo administrativos que redujeron significativamente la carga de trabajo manual del equipo de finanzas.</li>
                            </ul>
                        }
                    }
                    else
                    {
                        @if (Lang.IsEnglish)
                        {
                            <ul>
                                <li>Managed web infrastructure, APIs and MySQL databases ensuring operational continuity and system availability.</li>
                                <li>Provided asynchronous technical support and real-time incident resolution for administrative team users.</li>
                                <li>Automated administrative workflows, significantly reducing response times and manual intervention.</li>
                            </ul>
                        }
                        else
                        {
                            <ul>
                                <li>Administré la infraestructura web, APIs y bases de datos MySQL garantizando la continuidad operativa y disponibilidad del sistema.</li>
                                <li>Brindé soporte técnico asíncrono y resolución de incidencias en tiempo real para usuarios del equipo administrativo.</li>
                                <li>Automaticé flujos de trabajo administrativos que redujeron significativamente tiempos de atención e intervención manual.</li>
                            </ul>
                        }
                    }
                </div>
            </div>

            <div class="timeline-item animate-on-scroll">
                <div class="timeline-dot"></div>
                <div class="timeline-card">
                    <div class="timeline-header">
                        <div>
                            <h4>@(activeRole == 0 ? (Lang.IsEnglish ? "Software Development Intern" : "Practicante de Desarrollo de Software") : (Lang.IsEnglish ? "Support & Systems Intern" : "Practicante de Soporte & Sistemas"))</h4>
                            <p class="company"><i class="fas fa-building"></i> T-Systems México (Automotive)</p>
                        </div>
                        <span class="badge-date">@(Lang.IsEnglish ? "Jan 2024 – Apr 2024" : "Ene 2024 – Abr 2024")</span>
                    </div>
                    @if (activeRole == 0)
                    {
                        @if (Lang.IsEnglish)
                        {
                            <ul>
                                <li>Developed optimized PL/SQL scripts for operational data extraction, transformation, and structuring for fleet maintenance reporting (VW Project).</li>
                                <li>Automated ticket file processing and service tracking for corporate fleet users.</li>
                                <li>Identified and resolved data inconsistencies across corporate database environments.</li>
                                <li>Documented key technical processes following automotive industry quality standards.</li>
                            </ul>
                        }
                        else
                        {
                            <ul>
                                <li>Desarrollé scripts optimizados para la extracción, transformación y estructuración de datos operativos destinados a reportes de mantenimiento vehicular (Proyecto VW).</li>
                                <li>Automaticé el procesamiento de archivos de tickets y control de servicios para usuarios de flota empresarial.</li>
                                <li>Identifiqué y corregí inconsistencias de datos en entornos de base de datos corporativos.</li>
                                <li>Documenté técnicamente procesos clave bajo estándares de calidad de la industria automotriz.</li>
                            </ul>
                        }
                    }
                    else
                    {
                        @if (Lang.IsEnglish)
                        {
                            <ul>
                                <li>Managed IT service ticket processing and control for corporate fleet users (VW Project).</li>
                                <li>Identified, diagnosed and resolved data failures in Oracle SQL Developer environments.</li>
                                <li>Produced detailed technical documentation of operational processes following international quality standards.</li>
                            </ul>
                        }
                        else
                        {
                            <ul>
                                <li>Gestioné el procesamiento y control de tickets de servicio informático para la flota de usuarios empresariales (Proyecto VW).</li>
                                <li>Identifiqué, diagnosticé y corregí fallas de datos en entornos Oracle SQL Developer.</li>
                                <li>Elaboré documentación técnica detallada de procesos operativos bajo estándares internacionales de calidad.</li>
                            </ul>
                        }
                    }
                </div>
            </div>

            <div class="timeline-item animate-on-scroll">
                <div class="timeline-dot"></div>
                <div class="timeline-card">
                    <div class="timeline-header">
                        <div>
                            <h4>@(activeRole == 0 ? (Lang.IsEnglish ? "Software Developer (Professional Internship)" : "Desarrollador de Software (Estadía Profesional)") : (Lang.IsEnglish ? "Systems Support & Development" : "Soporte de Sistemas & Desarrollo"))</h4>
