@page "/"
@inject Portfolio.Services.LanguageService Lang
@implements IDisposable

<PageTitle>Victor Ortiz | @(activeRole == 0 ? "Software Engineer" : "IT Support Engineer")</PageTitle>

<!-- HERO -->
<section id="hero">
    <div class="hero-content">
        <p class="hero-greeting">@(Lang.IsEnglish ? "Hi, I'm" : "Hola, soy")</p>
        <h1>Victor Daniel Ortiz Garcia</h1>

        <div class="role-tabs">
            <button class="role-tab @(activeRole == 0 ? "active" : "")" @onclick="() => SetRole(0)">
                Jr. Software Engineer
            </button>
            <button class="role-tab @(activeRole == 1 ? "active" : "")" @onclick="() => SetRole(1)">
                IT Support Engineer
            </button>
            <div class="role-indicator" style="transform: translateX(@(activeRole == 0 ? "0%" : "100%"))"></div>
        </div>

        <p class="hero-summary">
            @if (activeRole == 0)
            {
                @if (Lang.IsEnglish)
                {
                    <text>Software Engineer specialized in Full-stack architecture and API design.
                    Experience delivering scalable solutions for international organizations.</text>
                }
                else
                {
                    <text>Ingeniero de Software especializado en arquitectura Full-stack y diseño de APIs.
                    Experiencia entregando soluciones escalables para organizaciones internacionales.</text>
                }
            }
            else
            {
                @if (Lang.IsEnglish)
                {
                    <text>IT Support Engineer with experience in L1/L2 technical support, hardware diagnostics,
                    network maintenance and ticket management in corporate environments.</text>
                }
                else
                {
                    <text>Ingeniero de Soporte TI con experiencia en soporte técnico L1/L2, diagnóstico de hardware,
                    mantenimiento de redes y gestión de tickets en entornos corporativos.</text>
                }
            }
        </p>

        <div class="hero-links">
            <a href="mailto:victorortiz.vg@hotmail.com" class="btn-primary-outline"><i class="fas fa-envelope"></i> Email</a>
            <a href="https://www.linkedin.com/in/vdortiz/" target="_blank" class="btn-primary-outline"><i class="fab fa-linkedin"></i> LinkedIn</a>
            <a href="https://github.com/VDaniel27" target="_blank" class="btn-primary-outline"><i class="fab fa-github"></i> GitHub</a>
            @if (Lang.IsEnglish)
            {
                <a href="resources/cv/Resume_Victor_Danie_Ortiz_Garcia.pdf" download class="btn-download"><i class="fas fa-download"></i> Download Resume</a>
            }
            else
            {
                <a href="resources/cv/CV_Victor_Daniel_Ortiz_Garcia.pdf" download class="btn-download"><i class="fas fa-download"></i> Descargar CV</a>
            }
        </div>
    </div>
    <div class="hero-scroll">
        <a href="#sobre-mi"><i class="fas fa-chevron-down"></i></a>
    </div>
</section>

<!-- SOBRE MÍ / ABOUT -->
<section id="sobre-mi" class="section">
    <div class="container">
        <h3 class="section-title">@(Lang.IsEnglish ? "About Me" : "Sobre mí")</h3>
        <div class="about-grid animate-on-scroll">
            <div class="about-avatar">
                <img src="resources/img/avatar.jpg" alt="Victor Ortiz" class="avatar-img" />
            </div>
            <div class="about-text">
                @if (Lang.IsEnglish)
                {
                    <p>Software Engineer with solid experience in the web application development lifecycle and data processing. Specialized in Full-stack architecture and API design.</p>
                    <p>Proven experience working autonomously for international organizations, solving technical problems through efficient code and strategic use of AI tools. Demonstrated ability to collaborate in high-demand corporate environments and deliver scalable solutions.</p>
                }
                else
                {
                    <p>Ingeniero de Software con sólida experiencia en el ciclo de vida de desarrollo de aplicaciones web y procesamiento de datos. Especializado en arquitectura Full-stack y diseño de APIs.</p>
                    <p>Experiencia demostrada trabajando de forma autónoma para organizaciones internacionales, resolviendo problemas técnicos mediante código eficiente y el uso estratégico de herramientas de IA. Capacidad probada para colaborar en entornos corporativos de alta exigencia y entregar soluciones escalables.</p>
                }
                <div class="about-meta">
                    <span><i class="fas fa-map-marker-alt"></i> Puebla, México</span>
                    <span><i class="fab fa-whatsapp"></i> <a href="https://wa.me/522211124385" target="_blank">WhatsApp</a></span>
                    <span><i class="fas fa-language"></i> @(Lang.IsEnglish ? "Native Spanish · Intermediate English" : "Español nativo · Inglés intermedio")</span>
                </div>
            </div>
        </div>
    </div>
</section>

