                        </div>
                        <span class="badge-date">@(Lang.IsEnglish ? "May 2022 – Aug 2022" : "May 2022 – Ago 2022")</span>
                    </div>
                    @if (activeRole == 0)
                    {
                        @if (Lang.IsEnglish)
                        {
                            <ul>
                                <li>Designed and built a warehouse management and inventory control system from scratch.</li>
                                <li>Implemented automated generation of executive PDF reports and material requisitions.</li>
                                <li>Designed and optimized relational database schemas to ensure high-performance queries.</li>
                            </ul>
                        }
                        else
                        {
                            <ul>
                                <li>Diseñé y desarrollé un sistema de gestión de almacén y control de inventarios desde cero.</li>
                                <li>Implementé la generación automática de reportes ejecutivos en PDF y requisiciones de materiales.</li>
                                <li>Diseñé y optimicé esquemas de bases de datos relacionales para asegurar consultas de alto rendimiento.</li>
                            </ul>
                        }
                    }
                    else
                    {
                        @if (Lang.IsEnglish)
                        {
                            <ul>
                                <li>Implemented and provided operational support for the warehouse and inventory management system for daily operations.</li>
                                <li>Diagnosed and resolved failures in data entry processes, automated report generation and requisitions.</li>
                                <li>Provided direct technical support to operational users for correct platform usage.</li>
                            </ul>
                        }
                        else
                        {
                            <ul>
                                <li>Implementé y di soporte operativo al sistema de gestión de almacén e inventarios para la operación diaria.</li>
                                <li>Diagnosticé y resolví fallas en procesos de captura, generación automática de reportes ejecutivos y requisiciones.</li>
                                <li>Brindé atención y soporte técnico directo a usuarios operativos para el correcto uso de la plataforma.</li>
                            </ul>
                        }
                    }
                </div>
            </div>

        </div>
    </div>
</section>

