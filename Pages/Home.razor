@page "/"
@inject Portfolio.Services.LanguageService Lang
@implements IDisposable

<PageTitle>Victor Ortiz | @(activeRole == 0 ? "Software Engineer" : "IT Support Engineer")</PageTitle>

<!-- HERO -->
<section id="hero">
    <div class="hero-content">
        <p class="hero-greeting">@(Lang.IsEnglish ? "Hi, I'm" : "Hola, soy")</p>
        <h1>Victor Daniel Ortiz Garcia</h1>

        <div class="role-tabs">
            <button class="role-tab @(activeRole == 0 ? "active" : "")" @onclick="() => SetRole(0)">
                Jr. Software Engineer
            </button>
            <button class="role-tab @(activeRole == 1 ? "active" : "")" @onclick="() => SetRole(1)">
                IT Support Engineer
            </button>
            <div class="role-indicator" style="transform: translateX(@(activeRole == 0 ? "0%" : "100%"))"></div>
        </div>

        <p class="hero-summary">
            @if (activeRole == 0)
            {
                @if (Lang.IsEnglish)
                {
                    <text>Software Engineer specialized in Full-stack architecture and API design.
                    Experience delivering scalable solutions for international organizations.</text>
                }
                else
                {
                    <text>Ingeniero de Software especializado en arquitectura Full-stack y diseño de APIs.
                    Experiencia entregando soluciones escalables para organizaciones internacionales.</text>
                }
            }
            else
            {
                @if (Lang.IsEnglish)
                {
                    <text>IT Systems &amp; Support Engineer with experience in hardware diagnostics, network configuration,
                    preventive/corrective maintenance and relational database administration. Proven ability to handle
                    incidents under SLA, provide remote and on-site support, and produce technical documentation
                    in high-demand corporate environments.</text>
                }
                else
                {
                    <text>Ingeniero de Sistemas y Soporte TI con experiencia en diagnóstico de hardware, configuración de redes,
                    mantenimiento preventivo/correctivo y administración de bases de datos relacionales. Capacidad probada para la
                    atención de incidencias bajo SLA, soporte remoto y presencial, y documentación técnica en entornos corporativos
                    de alta exigencia.</text>
                }
            }
        </p>

        <div class="hero-links">
            <a href="mailto:victorortiz.vg@hotmail.com" class="btn-primary-outline"><i class="fas fa-envelope"></i> Email</a>
            <a href="https://www.linkedin.com/in/vdortiz/" target="_blank" class="btn-primary-outline"><i class="fab fa-linkedin"></i> LinkedIn</a>
            <a href="https://github.com/VDaniel27" target="_blank" class="btn-primary-outline"><i class="fab fa-github"></i> GitHub</a>
            @if (Lang.IsEnglish)
            {
                <a href="resources/cv/Resume_Victor_Danie_Ortiz_Garcia.pdf" download class="btn-download"><i class="fas fa-download"></i> Download Resume</a>
            }
            else
            {
                <a href="resources/cv/CV_Victor_Daniel_Ortiz_Garcia.pdf" download class="btn-download"><i class="fas fa-download"></i> Descargar CV</a>
            }
        </div>
    </div>
    <div class="hero-scroll">
        <a href="#sobre-mi"><i class="fas fa-chevron-down"></i></a>
    </div>
</section>

<!-- SOBRE MÍ / ABOUT -->
<section id="sobre-mi" class="section">
    <div class="container">
        <h3 class="section-title">@(Lang.IsEnglish ? "About Me" : "Sobre mí")</h3>
        <div class="about-grid animate-on-scroll">
            <div class="about-avatar">
                <img src="resources/img/avatar.jpg" alt="Victor Ortiz" class="avatar-img" />
            </div>
            <div class="about-text">
                @if (Lang.IsEnglish)
                {
                    <p>Software Engineer with experience across the web application development lifecycle, RESTful API design, and relational database management. Specialized in Full-stack architecture, workflow automation, and data optimization in corporate and international collaborative environments.</p>
                    <p>Proven ability to deliver scalable, efficient, and results-oriented solutions.</p>
                }
                else
                {
                    <p>Ingeniero de Software con experiencia en el ciclo de vida de desarrollo de aplicaciones web, diseño de APIs RESTful y gestión de bases de datos relacionales. Especializado en arquitectura Full-stack, automatización de procesos y optimización de datos en entornos corporativos y de colaboración internacional.</p>
                    <p>Capacidad probada para entregar soluciones escalables, eficientes y orientadas a resultados.</p>
                }
                <div class="about-meta">
                    <span><i class="fas fa-map-marker-alt"></i> Puebla, México</span>
                    <span><i class="fab fa-whatsapp"></i> <a href="https://wa.me/522211124385" target="_blank">WhatsApp</a></span>
                    <span><i class="fas fa-language"></i> @(Lang.IsEnglish ? "Native Spanish · Intermediate English (technical reading, documentation & written communication)" : "Español nativo · Inglés intermedio (lectura técnica, documentación y comunicación escrita)")</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- EXPERIENCIA / EXPERIENCE -->
